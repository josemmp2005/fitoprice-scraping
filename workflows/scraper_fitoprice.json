{
  "id": "FitoPriceScraper",
  "name": "FitoPrice: leer precios de las tiendas",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Madrid",
    "saveManualExecutions": true
  },
  "nodes": [
    {
      "id": "3f0c1a8e-0001-4a51-9c11-000000000001",
      "name": "Cada día a las 7:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 7
            }
          ]
        }
      }
    },
    {
      "id": "3f0c1a8e-0002-4a51-9c11-000000000002",
      "name": "Ejecutar a mano",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "3f0c1a8e-0003-4a51-9c11-000000000003",
      "name": "Páginas activas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ],
      "notes": "GET /scraping/jobs: una fila por página activa, con sus selectores (los que se editan en Admin > Scraping).",
      "parameters": {
        "method": "GET",
        "url": "={{ $env.FITOPRICE_API_URL }}/scraping/jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.FITOPRICE_API_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3f0c1a8e-0004-4a51-9c11-000000000004",
      "name": "Descargar catálogo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ],
      "notes": "Descarga cada página y sigue el enlace rel=next hasta 20 páginas, con 1,5 s de pausa entre peticiones.",
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (compatible; FitoPriceBot/1.0)"
            },
            {
              "name": "Accept-Language",
              "value": "es-ES,es"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ ($response.body.match(/<link[^>]*rel=\"next\"[^>]*href=\"([^\"]+)\"/) || [])[1] }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !/<link[^>]*rel=\"next\"/.test($response.body) }}",
              "limitPagesFetched": true,
              "maxRequests": 20,
              "requestInterval": 1500
            }
          },
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          },
          "timeout": 30000
        }
      }
    },
    {
      "id": "3f0c1a8e-0005-4a51-9c11-000000000005",
      "name": "Datos de la página",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        100
      ],
      "notes": "Junta el HTML descargado con la tienda y los selectores de su página.",
      "parameters": {
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "company_id",
              "type": "number",
              "value": "={{ $('Páginas activas').item.json.company_id }}"
            },
            {
              "id": "a2",
              "name": "page_url",
              "type": "string",
              "value": "={{ $('Páginas activas').item.json.url }}"
            },
            {
              "id": "a3",
              "name": "selector_card",
              "type": "string",
              "value": "={{ $('Páginas activas').item.json.selector_card }}"
            },
            {
              "id": "a4",
              "name": "selector_title",
              "type": "string",
              "value": "={{ $('Páginas activas').item.json.selector_title }}"
            },
            {
              "id": "a5",
              "name": "selector_price",
              "type": "string",
              "value": "={{ $('Páginas activas').item.json.selector_price }}"
            },
            {
              "id": "a6",
              "name": "selector_image",
              "type": "string",
              "value": "={{ $('Páginas activas').item.json.selector_image }}"
            },
            {
              "id": "a7",
              "name": "selector_link",
              "type": "string",
              "value": "={{ $('Páginas activas').item.json.selector_link }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3f0c1a8e-0006-4a51-9c11-000000000006",
      "name": "Separar fichas",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        960,
        100
      ],
      "notes": "Una ficha por producto: así cada precio va siempre con su nombre, aunque a algún producto le falte el precio.",
      "parameters": {
        "operation": "extractHtmlContent",
        "dataPropertyName": "html",
        "extractionValues": {
          "values": [
            {
              "key": "cards",
              "cssSelector": "={{ $json.selector_card }}",
              "returnValue": "html",
              "returnArray": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3f0c1a8e-0007-4a51-9c11-000000000007",
      "name": "Una ficha por item",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        1200,
        100
      ],
      "parameters": {
        "fieldToSplitOut": "cards",
        "include": "noOtherFields",
        "options": {
          "destinationFieldName": "card"
        }
      }
    },
    {
      "id": "3f0c1a8e-0008-4a51-9c11-000000000008",
      "name": "Leer ficha",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        1440,
        100
      ],
      "parameters": {
        "operation": "extractHtmlContent",
        "dataPropertyName": "card",
        "extractionValues": {
          "values": [
            {
              "key": "name",
              "cssSelector": "={{ $('Datos de la página').item.json.selector_title }}",
              "returnValue": "html"
            },
            {
              "key": "price_html",
              "cssSelector": "={{ $('Datos de la página').item.json.selector_price }}",
              "returnValue": "html"
            },
            {
              "key": "img",
              "cssSelector": "={{ $('Datos de la página').item.json.selector_image }}",
              "returnValue": "attribute",
              "attribute": "src"
            },
            {
              "key": "img_lazy",
              "cssSelector": "={{ $('Datos de la página').item.json.selector_image }}",
              "returnValue": "attribute",
              "attribute": "data-src"
            },
            {
              "key": "link",
              "cssSelector": "={{ $('Datos de la página').item.json.selector_link }}",
              "returnValue": "attribute",
              "attribute": "href"
            }
          ]
        },
        "options": {
          "trimValues": true,
          "cleanUpText": true
        }
      }
    },
    {
      "id": "3f0c1a8e-0009-4a51-9c11-000000000009",
      "name": "Preparar envío",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        100
      ],
      "notes": "Precio a céntimos, URLs absolutas, sin duplicados y agrupado por tienda.",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Agrupa las fichas por tienda con el formato que espera POST /products/import:\n// [{ company_id, name: [...], price: [...céntimos], img: [...], link: [...], price_unit: [...] }]\n\nconst ENTITIES = { amp: '&', lt: '<', gt: '>', quot: '\"', apos: \"'\", nbsp: ' ', euro: '€' };\n\n// HTML -> texto plano: quita etiquetas, decodifica entidades y junta espacios\nconst toText = (html) => String(html ?? '')\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/&#x([0-9a-f]+);/gi, (_, hex) => String.fromCodePoint(parseInt(hex, 16)))\n  .replace(/&#(\\d+);/g, (_, dec) => String.fromCodePoint(Number(dec)))\n  .replace(/&([a-z]+);/gi, (all, name) => ENTITIES[name.toLowerCase()] ?? all)\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// \"1.250,50 €\" -> 125050. Con oferta (<ins>) vale el precio rebajado;\n// con \"Desde X\" o un rango, el primer importe.\nfunction parsePrice(html) {\n  let part = String(html ?? '');\n  const offer = part.match(/<ins\\b[^>]*>([\\s\\S]*?)<\\/ins>/i);\n  if (offer) part = offer[1];\n  const amountAt = part.search(/<[^>]*class=\"[^\"]*\\bamount\\b/);\n  if (amountAt >= 0) part = part.slice(amountAt);\n  const match = toText(part).match(/\\d{1,3}(?:\\.\\d{3})*(?:,\\d{1,2})?|\\d+(?:,\\d{1,2})?/);\n  if (!match) return null;\n  const value = parseFloat(match[0].replace(/\\./g, '').replace(',', '.'));\n  return Number.isFinite(value) && value > 0 ? Math.round(value * 100) : null;\n}\n\n// \"22,00 € por litro\" -> \"L\"; \"9,57 € por Kg\" -> \"kg\"; precio del envase -> null.\n// La API pasa esos precios a precio del envase con el tamaño que pone el nombre.\nfunction priceUnitOf(html) {\n  const match = toText(html).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase()\n    .match(/\\bpor\\s+(litros?|l|kilos?|kgs?)\\b/);\n  if (!match) return null;\n  return match[1].startsWith('l') ? 'L' : 'kg';\n}\n\n// URL absoluta a partir de la de la página (el sandbox de n8n no tiene URL)\nfunction absolute(value, base) {\n  const v = String(value ?? '').trim();\n  if (!v) return '';\n  if (/^https?:\\/\\//i.test(v)) return v;\n  if (v.startsWith('//')) return 'https:' + v;\n  const origin = (base.match(/^https?:\\/\\/[^/]+/i) || [''])[0];\n  if (v.startsWith('/')) return origin + v;\n  return base.replace(/[?#].*$/, '').replace(/[^/]*$/, '') + v;\n}\n\nconst groups = new Map();\nlet skipped = 0;\n\n$input.all().forEach((item, i) => {\n  const page = $('Datos de la página').itemMatching(i).json;\n  const name = toText(item.json.name);\n  const price = parsePrice(item.json.price_html);\n  if (!name || !price) { skipped++; return; }\n\n  if (!groups.has(page.company_id)) groups.set(page.company_id, new Map());\n  const byName = groups.get(page.company_id);\n  // Un producto puede salir en varias categorías: se queda la primera\n  if (byName.has(name)) return;\n  byName.set(name, {\n    name,\n    price,\n    price_unit: priceUnitOf(item.json.price_html),\n    img: absolute(item.json.img_lazy || item.json.img, page.page_url),\n    link: absolute(item.json.link, page.page_url),\n  });\n});\n\nconst data = [...groups].map(([company_id, byName]) => {\n  const list = [...byName.values()];\n  return {\n    company_id,\n    name: list.map((p) => p.name),\n    price: list.map((p) => p.price),\n    img: list.map((p) => p.img),\n    link: list.map((p) => p.link),\n    price_unit: list.map((p) => p.price_unit),\n  };\n});\n\nconst products = data.reduce((sum, g) => sum + g.name.length, 0);\nreturn [{ json: { data, products, skipped } }];"
      }
    },
    {
      "id": "3f0c1a8e-0010-4a51-9c11-000000000010",
      "name": "¿Hay productos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.products }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "3f0c1a8e-0011-4a51-9c11-000000000011",
      "name": "Guardar precios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        0
      ],
      "notes": "POST /products/import con la clave SCRAPER_API_KEY.",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FITOPRICE_API_URL }}/products/import",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.FITOPRICE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ data: $json.data }) }}",
        "options": {
          "timeout": 600000
        }
      }
    },
    {
      "id": "3f0c1a8e-0012-4a51-9c11-000000000012",
      "name": "Ningún producto leído",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        2160,
        200
      ],
      "notes": "Si ninguna página devuelve productos, lo más probable es que una tienda haya cambiado su HTML: revisa los selectores en Admin > Scraping.",
      "parameters": {
        "errorMessage": "No se ha leído ningún producto. Revisa los selectores de las páginas en Admin > Scraping."
      }
    }
  ],
  "connections": {
    "Cada día a las 7:00": {
      "main": [
        [
          {
            "node": "Páginas activas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ejecutar a mano": {
      "main": [
        [
          {
            "node": "Páginas activas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Páginas activas": {
      "main": [
        [
          {
            "node": "Descargar catálogo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Descargar catálogo": {
      "main": [
        [
          {
            "node": "Datos de la página",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Datos de la página": {
      "main": [
        [
          {
            "node": "Separar fichas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Separar fichas": {
      "main": [
        [
          {
            "node": "Una ficha por item",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Una ficha por item": {
      "main": [
        [
          {
            "node": "Leer ficha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Leer ficha": {
      "main": [
        [
          {
            "node": "Preparar envío",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar envío": {
      "main": [
        [
          {
            "node": "¿Hay productos?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Hay productos?": {
      "main": [
        [
          {
            "node": "Guardar precios",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ningún producto leído",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
